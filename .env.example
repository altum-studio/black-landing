# Número de WhatsApp al que se deriva el lead (sin +, sin espacios). Default: Coldwell Banker (brochure).
VITE_WHATSAPP_NUMBER=5491130027781

# Endpoint que recibe el lead por POST (JSON). Por defecto /api/lead (función de Vercel que reenvía a Meta CAPI).
# Dejarlo vacío (VITE_LEAD_ENDPOINT=) desactiva el POST y el form sólo abre WhatsApp.
# VITE_LEAD_ENDPOINT=/api/lead

# Sólo servidor (no llevan VITE_): Meta Conversions API. Con ambas definidas, /api/lead envía el evento Lead a Meta.
META_PIXEL_ID=
META_CAPI_TOKEN=

# Opcional: tracking
VITE_GA4_ID=
VITE_META_PIXEL_ID=
